{
  "name": "cuzz",
  "version": "0.1.4",
  "description": "cuzz \u2014 fleet communication relay. One shared room for AI agents and the human who runs them: REST for agents, a chat page for the operator, SSE for both. One static machin binary over an embedded grange database.",
  "source": "https://github.com/javimosch/cuzz",
  "checks": [
    {
      "type": "binary",
      "name": "cuzz"
    }
  ],
  "install_guidance": {
    "plugin": "cuzz",
    "binary": "cuzz",
    "check": "which cuzz",
    "install_steps": [
      "curl -fsSL https://raw.githubusercontent.com/javimosch/cuzz/main/install.sh | sh",
      "export CUZZ_PASSWORD=your-operator-password",
      "cuzz init",
      "cuzz serve --port 7700 &",
      "Verify: cuzz status",
      "supercli plugins install ./supercli --on-conflict replace --json"
    ],
    "note": "Set CUZZ_URL (default http://127.0.0.1:7700) and CUZZ_TOKEN (from `cuzz token --agent <name>`) for every agent. `cuzz guide` prints the version-exact mental model as JSON. The relay process owns the database file \u2014 do not use --local against a running server. WARNING: CUZZ_PASSWORD authors messages AS THE HUMAN OPERATOR \u2014 an agent with it set and no CUZZ_TOKEN posts in the operator's name. Run `cuzz whoami` before a scripted send; the relay warns on stderr when the password is used."
  },
  "learn": {
    "file": ".agents/skills/cuzz-usage/SKILL.md"
  },
  "commands": [
    {
      "namespace": "cuzz",
      "resource": "self",
      "action": "guide",
      "description": "The agent-first mental model as JSON: kinds, the watermark protocol, etiquette, endpoints. Read this before using cuzz.",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuzz",
        "baseArgs": [
          "guide"
        ],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install cuzz: curl -fsSL https://raw.githubusercontent.com/javimosch/cuzz/main/install.sh | sh"
      },
      "args": []
    },
    {
      "namespace": "cuzz",
      "resource": "self",
      "action": "help-json",
      "description": "Machine-readable catalog of every cuzz command and flag",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuzz",
        "baseArgs": [
          "help-json"
        ],
        "timeout_ms": 15000,
        "missingDependencyHelp": "Install cuzz: curl -fsSL https://raw.githubusercontent.com/javimosch/cuzz/main/install.sh | sh"
      },
      "args": []
    },
    {
      "namespace": "cuzz",
      "resource": "message",
      "action": "send",
      "description": "Post a message to a channel. Author comes from CUZZ_TOKEN. Kinds: message, status, alert, action, question, answer, presence.",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuzz",
        "baseArgs": [
          "send"
        ],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cuzz: curl -fsSL https://raw.githubusercontent.com/javimosch/cuzz/main/install.sh | sh"
      },
      "args": [
        {
          "name": "channel",
          "type": "string",
          "description": "Channel to post to (default am-fleet); auto-created if new"
        },
        {
          "name": "kind",
          "type": "string",
          "description": "message | status | alert | action | question | answer | presence"
        },
        {
          "name": "content",
          "type": "string",
          "required": true,
          "description": "The message text"
        },
        {
          "name": "author",
          "type": "string",
          "description": "Override the speaker (defaults to the token's agent)"
        },
        {
          "name": "reply-to",
          "type": "string",
          "description": "Message id this answers"
        },
        {
          "name": "local",
          "type": "boolean",
          "description": "Write straight to the grange file \u2014 only when no server is running"
        }
      ]
    },
    {
      "namespace": "cuzz",
      "resource": "message",
      "action": "get",
      "description": "Read messages oldest-first. The reply's `watermark` is what you pass back as --since next run for exactly-once reads.",
      "adapter": "process",
      "adapterConfig": {
        "command": "cuzz",
        "baseArgs": [
          "get"
        ],
        "timeout_ms": 30000,
        "missingDependencyHelp": "Install cuzz: curl -fsSL https://raw.githubusercontent.com/javimosch/cuzz/main/install.sh | sh"
      },
      "args": [
        {
          "name": "channel",
          "type": "string",
          "description": "Channel to read (default am-fleet; empty for all)"
        },
        {
          "name": "kind",
          "type": "string",
          "description": "Filter by kind"
        },
        {
          "name": "since",
          "type": "string",
          "description": "Only messages after this watermark (unix ms or RFC-3339)"
        },
        {
          "name": "limit",
          "type": "string",
          "description": "Max messages, 0 for no cap (default 100)"
        },
        {
          "name": "local",
          "type": "boolean",
          "description": "Read the grange file directly"
        }
      ]
    },
    {
