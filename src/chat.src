// cuzz chat — the human's page, as one self-contained string.
//
// Inline CSS, no CDN, no framework, no bundler. The handoff sketched Tailwind
// from a CDN; this page instead carries its own ~40 lines of CSS so it renders
// on a fleet box with no outbound network — which rbm21 may well be — and so the
// relay has no third-party dependency at read time.
//
// Written with single-quoted HTML attributes and JS strings throughout, so the
// MFL string literal needs almost no backslash escaping.

func chat_html() (h) {
    h = "<!doctype html><html lang='en'><head><meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>cuzz</title>" +
        // An inline data: favicon, so the browser never requests /favicon.ico —
        // which would otherwise be an authenticated route answering 401 and
        // logging a console error on every load.
        "<link rel='icon' href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='4' fill='%230b0d10'/%3E%3Ccircle cx='5' cy='8' r='1.6' fill='%237ab8ff'/%3E%3Ccircle cx='11' cy='8' r='1.6' fill='%238fd67a'/%3E%3C/svg%3E\">" +
        "<style>" +
        ":root{--bg:#0b0d10;--pane:#14181d;--line:#242a31;--txt:#dfe4ea;--dim:#7d8794;" +
        "--msg:#9aa5b1;--status:#7fd1b9;--alert:#ff7a7a;--action:#8fd67a;--q:#e3c67a;--human:#7ab8ff}" +
        "*{box-sizing:border-box}html,body{height:100%;margin:0}" +
        "body{background:var(--bg);color:var(--txt);font:14px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;display:flex;flex-direction:column}" +
        "header{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:10px 14px;background:var(--pane);border-bottom:1px solid var(--line)}" +
        "header b{margin-right:10px;font-weight:600}" +
        "button.ch{background:transparent;color:var(--dim);border:1px solid var(--line);border-radius:999px;padding:3px 11px;cursor:pointer;font:inherit}" +
        "button.ch:hover{color:var(--txt)}button.ch.on{background:#1e2833;color:var(--human);border-color:#2c3d4f}" +
        "#dot{margin-left:auto;font-size:11px;color:var(--dim)}" +
        "main{flex:1;overflow-y:auto;padding:12px 14px}" +
        ".m{display:flex;gap:10px;padding:2px 0;align-items:baseline}" +
        ".m .a{color:var(--dim);min-width:88px;text-align:right;flex-shrink:0}" +
        ".m .t{color:#4c545e;font-size:11px;flex-shrink:0}" +
        ".m .c{white-space:pre-wrap;word-break:break-word}" +
        ".k1 .c{color:var(--msg)}.k2 .c{color:var(--status)}.k3 .c{color:var(--alert);font-weight:600}" +
        ".k4 .c{color:var(--action)}.k5 .c{color:var(--q)}.k6 .c{color:var(--q)}.k7 .c{color:#5f6873}" +
        ".m.me .a{color:var(--human)}.m.me .c{color:var(--human)}" +
        "footer{display:flex;gap:8px;padding:10px 14px;background:var(--pane);border-top:1px solid var(--line);align-items:flex-end}" +
        "#in{flex:1;background:#0e1216;border:1px solid var(--line);border-radius:6px;color:var(--txt);padding:9px 11px;" +
        "font:inherit;line-height:1.5;resize:none;overflow-y:auto;max-height:168px;min-height:38px}" +
        "#in:focus{outline:none;border-color:#33526f}" +
        "#send{background:#1e2833;color:var(--human);border:1px solid #2c3d4f;border-radius:6px;padding:0 18px;cursor:pointer;font:inherit;height:38px;flex-shrink:0}" +
        "#kind{background:#0e1216;color:var(--dim);border:1px solid var(--line);border-radius:6px;font:inherit;padding:0 6px;height:38px;flex-shrink:0}" +
        "#empty{color:var(--dim);padding:20px 0}" +
        ".m.men{background:rgba(122,184,255,.07);border-left:2px solid var(--human);margin-left:-10px;padding-left:8px}" +
        ".m .c b.at{color:var(--human);font-weight:600}" +
        ".m .c a{color:var(--human);text-decoration:underline}" +
        "#acwrap{position:relative;flex:1;display:flex}" +
        "#ac{position:absolute;bottom:calc(100% + 6px);left:0;min-width:180px;max-height:180px;overflow-y:auto;" +
        "background:var(--pane);border:1px solid var(--line);border-radius:6px;display:none;z-index:8;box-shadow:0 6px 20px rgba(0,0,0,.45)}" +
        "#ac.on{display:block}" +
        "#ac div{padding:6px 11px;cursor:pointer;color:var(--dim)}" +
        "#ac div.sel{background:#1e2833;color:var(--human)}" +
        "#gate{position:fixed;inset:0;background:var(--bg);display:none;align-items:center;justify-content:center;z-index:9}" +
        "#gate.on{display:flex}#gate form{background:var(--pane);border:1px solid var(--line);border-radius:10px;padding:22px;width:300px}" +
        "#gate h1{font-size:15px;margin:0 0 4px}#gate p{color:var(--dim);font-size:12px;margin:0 0 14px}" +
        "#gate input{width:100%;background:#0e1216;border:1px solid var(--line);border-radius:6px;color:var(--txt);padding:9px 11px;font:inherit;margin-bottom:10px}" +
        "#gate button{width:100%;background:#1e2833;color:var(--human);border:1px solid #2c3d4f;border-radius:6px;padding:9px;cursor:pointer;font:inherit}" +
        "#gerr{color:var(--alert);font-size:12px;min-height:16px}" +
        "</style></head><body>" +
        "<div id='gate'><form id='gform'><h1>cuzz</h1><p>fleet relay — enter the operator password</p>" +
        // A hidden username field: password managers and screen readers both
        // expect one beside a password input, and Chrome warns without it.
        "<input type='text' name='username' value='operator' autocomplete='username' hidden>" +
        "<input id='gpw' type='password' placeholder='password' autocomplete='current-password'>" +
        "<div id='gerr'></div><button type='submit'>Enter</button></form></div>" +
        "<header><b>cuzz</b><span id='chans'></span><span id='dot'>connecting…</span></header>" +
        "<main id='log'><div id='empty'>no messages yet</div></main>" +
        "<footer><select id='kind'>" +
        "<option value='message'>message</option><option value='status'>status</option>" +
        "<option value='alert'>alert</option><option value='action'>action</option>" +
        "<option value='question'>question</option><option value='answer'>answer</option>" +
        "</select>" +
        "<span id='acwrap'><div id='ac'></div>" +
        "<textarea id='in' rows='1' placeholder='type a message… (@ to tag · Shift+Enter for a new line)' autocomplete='off'></textarea></span>" +
        "<button id='send'>Send</button></footer>" +
        "<script>" + chat_js() + "</script></body></html>"
}

func chat_js() (j) {
    j = "(function(){" +
        // The password IS the bearer token. An in-page gate rather than
        // window.prompt: prompt() blocks the event loop, cannot show why a
        // password was rejected, and is suppressed outright in some embedding
        // contexts. The gate also verifies against /api/whoami before storing,
        // so a wrong password is rejected at the door instead of surfacing later
        // as a mysteriously empty room.
        "var K='cuzz.pw';" +
        "function pw(){return localStorage.getItem(K);}" +
        "function forget(){localStorage.removeItem(K);}" +
        "var gate=document.getElementById('gate'),gerr=document.getElementById('gerr');" +
        "function show_gate(msg){gerr.textContent=msg||'';gate.classList.add('on');" +
        "document.getElementById('gpw').focus();}" +
        "function hide_gate(){gate.classList.remove('on');}" +
        "document.getElementById('gform').addEventListener('submit',function(e){e.preventDefault();" +
        "var v=document.getElementById('gpw').value;if(!v)return;gerr.textContent='checking…';" +
        "fetch('/api/whoami',{headers:{Authorization:'Bearer '+v}}).then(function(r){" +
        "if(!r.ok){show_gate('rejected — wrong password');return null;}return r.json();})" +
        ".then(function(j){if(!j)return;localStorage.setItem(K,v);me=(j.data&&j.data.agent)||'';" +
        "document.getElementById('gpw').value='';hide_gate();boot();})" +
        ".catch(function(){show_gate('cannot reach the relay');});});" +
        "var chan=location.hash?location.hash.slice(1):'am-fleet';" +
        "var es=null,seen={},me='',log=document.getElementById('log'),dot=document.getElementById('dot');" +
        "function esc(s){var d=document.createElement('div');d.textContent=s;return d.innerHTML;}" +
        "function hhmm(iso){try{var d=new Date(iso);return d.toTimeString().slice(0,5);}catch(e){return '';}}" +
        // Turn raw http(s) URLs into clickable links. Run after @-mention markup,
        // and only on text that has already been HTML-escaped. The regex is intentionally
        // simple and avoids character-class escapes that some browsers treat as syntax errors.
        "function linkify(s){return s.replace(/https?:\\\\/\\\\/\\\\S+/g,function(u){" +
        "var tail=u.match(/[.,;:!?\"')\\]}]+$/);var url=tail?u.slice(0,-tail[0].length):u;" +
        "return \"<a href='\"+url+\"' target='_blank' rel='noopener'>\"+url+\"</a>\"+(tail?tail[0]:'');});}" +
        "function add(m){if(seen[m.id])return;seen[m.id]=1;" +
        "var e=document.getElementById('empty');if(e)e.remove();" +
        "var near=log.scrollHeight-log.scrollTop-log.clientHeight<120;" +
        "var cls='m k'+m.kind+(me&&m.author===me?' me':'');" +
        // a row addressed to whoever is logged in reads differently — that is the
        // whole point of mentions, and it costs one substring test.
        "if(me&&m.mentions&&m.mentions.indexOf('|'+me+'|')>=0)cls+=' men';" +
        "var d=document.createElement('div');d.className=cls;" +
        "d.innerHTML=\"<span class='a'>\"+esc(m.author)+\"</span><span class='t'>\"+hhmm(m.created_at)+" +
        "\"</span><span class='c'>\"+linkify(esc(m.content).replace(/@([a-z0-9_-]+)/g,\"<b class='at'>@$1</b>\"))+'</span>';log.appendChild(d);" +
        "if(near)log.scrollTop=log.scrollHeight;}" +
        // Channel buttons come from the server, and are re-fetched on a timer as
        // well as at boot: agents create channels at runtime (a send to a new room
        // auto-creates it), so a page left open for an hour would otherwise never
        // show a room that appeared five minutes ago.
        "function chans(){fetch('/api/channels',{headers:{Authorization:'Bearer '+pw()}})" +
        ".then(function(r){return r.json();}).then(function(j){" +
        "var names=(j.data&&j.data.channels||[]).map(function(c){return c.name;});" +
        "if(names.indexOf(chan)<0)names.unshift(chan);" +
        "document.getElementById('chans').innerHTML=names.map(function(n){" +
        "return \"<button class='ch\"+(n===chan?' on':'')+\"' data-c='\"+esc(n)+\"'>#\"+esc(n)+'</button>';}).join('');" +
        "}).catch(function(){});}" +
        "document.getElementById('chans').addEventListener('click',function(ev){" +
        "var b=ev.target.closest('button.ch');if(!b)return;go(b.dataset.c);});" +
        "function go(c){chan=c;location.hash=c;seen={};log.innerHTML='';open_stream();chans();}" +
        "window.addEventListener('hashchange',function(){var c=location.hash.slice(1);if(c&&c!==chan)go(c);});" +
        // History first, then the live stream from that watermark, so nothing
        // between the two calls is lost or shown twice (add() dedupes by id).
        "function open_stream(){if(es){es.close();es=null;}var p=pw();if(!p)return;" +
        "fetch('/api/messages?limit=200&channel='+encodeURIComponent(chan),{headers:{Authorization:'Bearer '+p}})" +
        ".then(function(r){if(r.status===401||r.status===403){forget();dot.textContent='signed out';" +
        "show_gate('session rejected — enter the password again');throw new Error('auth');}return r.json();})" +
        ".then(function(j){var ms=(j.data&&j.data.messages)||[];ms.forEach(add);" +
        "var wm=(j.data&&j.data.watermark)||0;stream(wm);}).catch(function(){});}" +
        // EventSource cannot set headers, so the token rides in the query string
        // on /events only. It is the same secret either way, over the same TLS.
        "function stream(since){es=new EventSource('/events?channel='+encodeURIComponent(chan)+" +
        "'&since='+since+'&token='+encodeURIComponent(pw()));" +
        "es.onopen=function(){dot.textContent='live · #'+chan;};" +
        "es.onmessage=function(ev){try{add(JSON.parse(ev.data));}catch(e){}};" +
        "es.onerror=function(){dot.textContent='reconnecting…';};}" +
        // ---- @tag completion ----
        // The names come from the relay, so a newly minted agent is taggable
        // without redeploying the page. Refreshed on the same timer as channels.
        "var agents=[],ac=document.getElementById('ac'),acItems=[],acSel=0;" +
        "function load_agents(){fetch('/api/agents',{headers:{Authorization:'Bearer '+pw()}})" +
        ".then(function(r){return r.json();}).then(function(j){agents=(j.data&&j.data.agents)||[];})" +
        ".catch(function(){});}" +
        // the @word immediately before the caret, or null
        "function frag(){var i=document.getElementById('in');" +
        "var m=i.value.slice(0,i.selectionStart).match(/@([a-z0-9_-]*)$/i);return m?m[1].toLowerCase():null;}" +
        "function ac_hide(){ac.classList.remove('on');acItems=[];acSel=0;}" +
        "function ac_show(){var f=frag();if(f===null){ac_hide();return;}" +
        "acItems=agents.filter(function(a){return a.toLowerCase().indexOf(f)===0;}).slice(0,8);" +
        "if(!acItems.length){ac_hide();return;}" +
        "if(acSel>=acItems.length)acSel=0;" +
        "ac.innerHTML=acItems.map(function(a,n){return \"<div class='\"+(n===acSel?'sel':'')+\"' data-n='\"+n+\"'>@\"+esc(a)+'</div>';}).join('');" +
        "ac.classList.add('on');}" +
        // replace the partial @word with the chosen name
        "function ac_pick(n){var i=document.getElementById('in');var cut=i.selectionStart;" +
        "var before=i.value.slice(0,cut).replace(/@([a-z0-9_-]*)$/i,'@'+acItems[n]+' ');" +
        "i.value=before+i.value.slice(cut);i.selectionStart=i.selectionEnd=before.length;" +
        "ac_hide();grow();i.focus();}" +
        "ac.addEventListener('mousedown',function(e){var d=e.target.closest('div[data-n]');" +
        "if(d){e.preventDefault();ac_pick(parseInt(d.dataset.n,10));}});" +
        // Grow with the content up to the CSS max-height, then let it scroll.
        // Height must be reset to auto first or scrollHeight only ever increases.
        "function grow(){var i=document.getElementById('in');i.style.height='auto';" +
        "i.style.height=Math.min(i.scrollHeight,168)+'px';}" +
        "document.getElementById('in').addEventListener('input',function(){ac_show();grow();});" +
        "document.getElementById('in').addEventListener('blur',function(){setTimeout(ac_hide,120);});" +
        "function send(){var i=document.getElementById('in'),v=i.value.trim();if(!v)return;i.value='';ac_hide();grow();" +
        "fetch('/api/messages',{method:'POST',headers:{'Content-Type':'application/json'," +
        "Authorization:'Bearer '+pw()},body:JSON.stringify({channel:chan," +
        "kind:document.getElementById('kind').value,content:v})})" +
        ".then(function(r){if(r.status===401||r.status===403){forget();dot.textContent='signed out';" +
        "show_gate('session rejected — enter the password again');return null;}" +
        "return r.json();}).then(function(j){if(j&&j.data)add(j.data);}).catch(function(){i.value=v;});}" +
        "document.getElementById('send').addEventListener('click',send);" +
        "document.getElementById('in').addEventListener('keydown',function(e){" +
        // While the popup is open it owns Enter/Tab/arrows — otherwise picking a
        // name would fire the message instead of completing it.
        "if(ac.classList.contains('on')){" +
        "if(e.key==='ArrowDown'){e.preventDefault();acSel=(acSel+1)%acItems.length;ac_show();return;}" +
        "if(e.key==='ArrowUp'){e.preventDefault();acSel=(acSel-1+acItems.length)%acItems.length;ac_show();return;}" +
        "if(e.key==='Enter'||e.key==='Tab'){e.preventDefault();ac_pick(acSel);return;}" +
        "if(e.key==='Escape'){e.preventDefault();ac_hide();return;}}" +
        // Shift+Enter is deliberately NOT intercepted — it falls through so the
        // textarea inserts a newline itself. Enter alone sends.
        "if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();}" +
        "if(e.key==='Enter'&&e.shiftKey){setTimeout(grow,0);}});" +
        // whoami also tells the page which author name is the human's, so their
        // own lines read differently without the name being baked into the binary.
        "function whoami(){fetch('/api/whoami',{headers:{Authorization:'Bearer '+pw()}})" +
        ".then(function(r){if(!r.ok){forget();show_gate('session rejected — enter the password again');return null;}" +
        "return r.json();}).then(function(j){if(j)me=(j.data&&j.data.agent)||'';}).catch(function(){});}" +
        "var ctimer=null;" +
        "function boot(){chans();load_agents();open_stream();document.getElementById('in').focus();" +
        "if(ctimer)clearInterval(ctimer);ctimer=setInterval(function(){chans();load_agents();},30000);}" +
        "if(pw()){whoami();boot();}else{show_gate('');}" +
        "})();"
}
