// cuzz relay — the model. Channels, messages, tokens.
// Every write and read the CLI and the HTTP server do goes through here, so
// there is one storage code path however the call arrived.

func kind_name(k) (n) {
    n = "message"
    if k == 2 { n = "status" }
    if k == 3 { n = "alert" }
    if k == 4 { n = "action" }
    if k == 5 { n = "question" }
    if k == 6 { n = "answer" }
    if k == 7 { n = "presence" }
}

func kind_num(s) (k) {
    k = 0
    if s == "message" || s == "1" { k = 1 }
    if s == "status" || s == "2" { k = 2 }
    if s == "alert" || s == "3" { k = 3 }
    if s == "action" || s == "4" { k = 4 }
    if s == "question" || s == "5" { k = 5 }
    if s == "answer" || s == "6" { k = 6 }
    if s == "presence" || s == "7" { k = 7 }
}

// valid_name keeps channel and author names to the shape a shell, a URL query
// and a JSON document all handle without quoting: [a-z0-9_-], <= 40 chars.
func valid_name(s) (ok) {
    ok = 0
    if len(s) == 0 || len(s) > 40 { return }
    i := 0
    while i < len(s) {
        c := charat(s, i)
        good := 0
        if c >= "a" && c <= "z" { good = 1 }
        if c >= "0" && c <= "9" { good = 1 }
        if c == "-" || c == "_" { good = 1 }
        if good == 0 { return }
        i = i + 1
    }
    ok = 1
}

// ---- schema ----

func ensure_schema() (ok) {
    ok = 0
    if st_index("messages", "channel", "") == 0 { return }
    if st_index("messages", "kind", "") == 0 { return }
    if st_index("messages", "ts", "range") == 0 { return }
    if st_index("messages", "mentions", "") == 0 { return }
    if st_index("channels", "name", "") == 0 { return }
    if st_index("tokens", "agent", "") == 0 { return }
    ok = 1
}

// ---- channels ----

func chan_exists(name) (yes) {
    yes = 0
    _, found := st_get("channels", name)
    if found == 1 { yes = 1 }
}

func chan_create(name) (ok) {
    ok = 0
    if valid_name(name) == 0 { return }
    if chan_exists(name) == 1 { ok = 1  return }
    ms := now_ms()
    doc := "{\"id\":\"" + name + "\",\"name\":\"" + name + "\",\"ts\":" + str(ms) + ",\"created_at\":\"" + iso_ms(ms) + "\"}"
    ok = st_put("channels", name, doc)
}

func chan_list() (data) {
    docs := items_docs(st_find("channels", "", 0))
    data = "{\"count\":" + str(len(docs)) + ",\"channels\":[" + join(docs, ",") + "]}"
}

// chan_delete removes a channel and every message in it. Channels auto-create on
// first send, which makes a fat-fingered name permanent without this — the
// tradeoff only works if it is reversible.
//
// The messages are deleted under ONE commit rather than one commit each: a
// channel with thousands of messages would otherwise fsync thousands of times,
// and a half-deleted channel is a worse outcome than a slow one.
func chan_delete(name) (nmsgs, errcode, errmsg) {
    nmsgs = 0
    errcode = 0
    errmsg = ""
    if valid_name(name) == 0 {
        errcode = 80
        errmsg = "invalid channel name: " + name
        return
    }
    if chan_exists(name) == 0 {
        errcode = 80
        errmsg = "no such channel: " + name
        return
    }
    ids := items_ids(st_find("messages", "channel=" + name, 0))
    if len(ids) > 0 {
        if st_use("messages") == 0 {
            errcode = 110
            errmsg = "could not open the messages collection"
            return
        }
        i := 0
        while i < len(ids) {
            if gr_del(ids[i]) == 1 { nmsgs = nmsgs + 1 }
            i = i + 1
        }
        if gr_commit() == 0 {
            errcode = 110
            errmsg = "could not commit the message deletions"
            return
        }
    }
    if st_del("channels", name) == 0 {
        errcode = 110
        errmsg = "messages were deleted but the channel record was not"
        return
    }
}

// ---- mentions ----
// An @name is only registered if it resolves to a real speaker. An unresolvable
// @typo stays visible in the content but must not create a phantom addressee —
// the same reasoning that made channel auto-create need a delete verb.
func mention_ok(name) (yes) {
    yes = 0
    if len(name) == 0 { return }
    human := env("CUZZ_HUMAN")
    if len(human) == 0 { human = "human" }
    if name == human { yes = 1  return }
    _, found := tok_for_agent(name)
    if found == 1 { yes = 1 }
}

// parse_mentions returns (delimited, list). The delimited form "|a|b|" is what
// gets stored and queried: grange indexes scalar tokens, so an array field could
// not be matched at all, whereas "mentions~=|a|" reuses the substring operator
// that already exists. The list is for display only — never query it.
func parse_mentions(content) (delim, list) {
    delim = ""
    list = []string{}
    names := []string{}
    i := 0
    n := len(content)
    while i < n {
        if charat(content, i) != "@" {
            i = i + 1
            continue
        }
        j := i + 1
        name := ""
        while j < n {
            c := to_lower(charat(content, j))
            good := 0
            if c >= "a" && c <= "z" { good = 1 }
            if c >= "0" && c <= "9" { good = 1 }
            if c == "-" || c == "_" { good = 1 }
            if good == 0 { break }
            name = name + c
            j = j + 1
        }
        if len(name) > 0 && mention_ok(name) == 1 {
            dup := 0
            k := 0
            while k < len(names) {
                if names[k] == name { dup = 1 }
                k = k + 1
            }
            if dup == 0 {
                names = append(names, name)
                list = append(list, "\"" + name + "\"")
            }
        }
        i = j
    }
    if len(names) > 0 { delim = "|" + join(names, "|") + "|" }
}

// ---- messages ----

func msg_id() (id) {
    id = "msg_" + to_hex(rand_bytes(6))
}

// msg_append is the single append path. Channels are auto-created on first
// message: an agent that invents #hitl mid-run should not need a second call,
// and a typo'd channel is visible in `cuzz channels` rather than silently lost.
func msg_append(channel, author, kindStr, content, reply_to) (doc, errcode, errmsg) {
    doc = ""
    errcode = 0
    errmsg = ""
    if valid_name(channel) == 0 {
        errcode = 80
        errmsg = "invalid channel name (use a-z 0-9 - _, max 40 chars): " + channel
        return
    }
    if valid_name(author) == 0 {
        errcode = 80
        errmsg = "invalid author name (use a-z 0-9 - _, max 40 chars): " + author
        return
    }
    if len(content) == 0 {
        errcode = 80
        errmsg = "content is empty"
        return
    }
    if len(content) > 8000 {
        errcode = 80
        errmsg = "content exceeds 8000 bytes"
        return
    }
    k := kind_num(kindStr)
    if k == 0 {
        errcode = 80
        errmsg = "unknown kind: " + kindStr + " (message|status|alert|action|question|answer|presence or 1-7)"
        return
    }
    if chan_create(channel) == 0 {
        errcode = 110
        errmsg = "could not create channel " + channel
        return
    }
    id := msg_id()
    ms := now_ms()
    mdelim, mlist := parse_mentions(content)
    d := "{\"id\":\"" + id + "\",\"channel\":\"" + channel + "\",\"author\":\"" + author + "\"" +
        ",\"kind\":" + str(k) + ",\"kind_name\":\"" + kind_name(k) + "\"" +
        ",\"content\":\"" + jesc_c(content) + "\",\"reply_to\":\"" + jesc_c(reply_to) + "\"" +
        ",\"mentions\":\"" + mdelim + "\",\"mentions_list\":[" + join(mlist, ",") + "]" +
        ",\"ts\":" + str(ms) + ",\"created_at\":\"" + iso_ms(ms) + "\"}"
    if st_put("messages", id, d) == 0 {
        errcode = 110
        errmsg = "write failed"
        return
    }
    doc = d
}

// msg_query builds a grange where-clause from the filter set. Clauses are
// ANDed; `channel` and `kind` hit equality indexes, `since` ranges on ts, and
// `q` is a case-insensitive substring over content.
func msg_where(channel, kindStr, since, q, mentions) (where) {
    cl := []string{}
    if len(channel) > 0 { cl = append(cl, "channel=" + channel) }
    if len(kindStr) > 0 {
        k := kind_num(kindStr)
        if k > 0 { cl = append(cl, "kind=" + str(k)) }
    }
    if since > 0 { cl = append(cl, "ts>" + str(since)) }
    if len(q) > 0 { cl = append(cl, "content~=" + q) }
    // matched against the delimited form so @build does not match @builder
    if len(mentions) > 0 { cl = append(cl, "mentions~=|" + to_lower(mentions) + "|") }
    where = join(cl, ",")
}

// msg_query returns messages oldest-first. `tail` asks for the NEWEST n instead —
// which is what "give me recent context" means, and which a plain limit cannot
// express: results are ascending, so `--since 0 --limit 100` hands back the
// hundred OLDEST messages and then parks the watermark just past them. An agent
// with no watermark wants the end of the conversation, not the start of it.
func msg_query(channel, kindStr, since, q, limit, tail, mentions) (data) {
    where := msg_where(channel, kindStr, since, q, mentions)
    if limit < 0 { limit = 0 }
    docs := []string{}
    if tail > 0 {
        // walk descending to take the newest n, then flip back to chronological
        // order so the caller always reads a conversation forwards.
        nd := items_docs(st_find_ordered("messages", where, tail, "ts", 1))
        i := len(nd) - 1
        while i >= 0 {
            docs = append(docs, nd[i])
            i = i - 1
        }
    } else {
        docs = items_docs(st_find_ordered("messages", where, limit, "ts", 0))
    }
    hi := 0
    i = 0
    while i < len(docs) {
        tv, terr := json_get(docs[i], ".ts")
        if len(terr) == 0 {
            t := parse_int(tv)
            if t > hi { hi = t }
        }
        i = i + 1
    }
    // `watermark` is what the caller passes back as --since next run: the
    // highest ts actually returned, not now_ms(), so a message committed
    // between the query and the reply is not skipped.
    data = "{\"count\":" + str(len(docs)) + ",\"watermark\":" + str(hi) +
        ",\"messages\":[" + join(docs, ",") + "]}"
}

// msg_delete removes one message. Admin only at the HTTP layer: an editor agent
// must not be able to erase a peer's words, or the room stops being a record.
func msg_delete(id) (errcode, errmsg) {
    errcode = 0
    errmsg = ""
    if has_prefix(id, "msg_") == false {
        errcode = 80
        errmsg = "not a message id (expected msg_...): " + id
        return
    }
    _, found := st_get("messages", id)
    if found == 0 {
        errcode = 80
        errmsg = "no such message: " + id
        return
    }
    if st_del("messages", id) == 0 {
        errcode = 110
        errmsg = "delete failed for " + id
        return
    }
}

// ---- tokens ----
// A token is a bearer string mapped to an agent name and a role. "admin" may
// create channels and mint tokens; "editor" may send and read.

func tok_new(prefix) (t) {
    t = prefix + to_hex(rand_bytes(16))
}

func tok_put(token, agent, role) (ok) {
    ms := now_ms()
    doc := "{\"token\":\"" + token + "\",\"agent\":\"" + agent + "\",\"role\":\"" + role + "\"" +
        ",\"ts\":" + str(ms) + ",\"created_at\":\"" + iso_ms(ms) + "\"}"
    ok = st_put("tokens", token, doc)
}

// tok_lookup resolves a bearer token to (agent, role). An unknown token yields
// empty strings — callers must treat that as unauthenticated.
func tok_lookup(token) (agent, role) {
    agent = ""
    role = ""
    if len(token) == 0 { return }
    doc, found := st_get("tokens", token)
    if found == 0 { return }
    av, aerr := json_get(doc, ".agent")
    rv, rerr := json_get(doc, ".role")
    if len(aerr) > 0 || len(rerr) > 0 { return }
    agent = unq(av)
    role = unq(rv)
}

// agent_names lists who can be @-mentioned: every agent that holds a token, plus
// the operator. Deliberately separate from tok_list — this is readable by any
// authenticated caller and must never carry a credential.
func agent_names() (data) {
    docs := items_docs(st_find("tokens", "", 0))
    names := []string{}
    human := env("CUZZ_HUMAN")
    if len(human) == 0 { human = "human" }
    names = append(names, "\"" + jesc_c(human) + "\"")
    i := 0
    while i < len(docs) {
        av, aerr := json_get(docs[i], ".agent")
        if len(aerr) == 0 {
            nm := unq(av)
            dup := 0
            j := 0
            while j < len(names) {
                if names[j] == "\"" + nm + "\"" { dup = 1 }
                j = j + 1
            }
            if dup == 0 { names = append(names, "\"" + jesc_c(nm) + "\"") }
        }
        i = i + 1
    }
    data = "{\"count\":" + str(len(names)) + ",\"agents\":[" + join(names, ",") + "]}"
}

func tok_list() (data) {
    docs := items_docs(st_find("tokens", "", 0))
    out := []string{}
    i := 0
    while i < len(docs) {
        // never echo the secret back in a listing
        av, _ := json_get(docs[i], ".agent")
        rv, _ := json_get(docs[i], ".role")
        cv, _ := json_get(docs[i], ".created_at")
        tv, _ := json_get(docs[i], ".token")
        hint := unq(tv)
        if len(hint) > 10 { hint = substr(hint, 0, 10) + "…" }
        out = append(out, "{\"agent\":" + av + ",\"role\":" + rv + ",\"created_at\":" + cv + ",\"token_prefix\":\"" + hint + "\"}")
        i = i + 1
    }
    data = "{\"count\":" + str(len(out)) + ",\"tokens\":[" + join(out, ",") + "]}"
}

// tok_mint is idempotent per agent name: an agent that already has a token gets
// the same one back rather than a second valid credential nobody tracks.
// Returns (token, created, errcode, errmsg).
func tok_mint(agent, role) (token, created, errcode, errmsg) {
    token = ""
    created = 0
    errcode = 0
    errmsg = ""
    if valid_name(agent) == 0 {
        errcode = 80
        errmsg = "invalid agent name (use a-z 0-9 - _, max 40 chars): " + agent
        return
    }
    if role != "admin" && role != "editor" {
        errcode = 80
        errmsg = "role must be admin or editor, got: " + role
        return
    }
    t, found := tok_for_agent(agent)
    if found == 1 { token = t  return }
    t = tok_new("ct_")
    if role == "admin" { t = tok_new("ca_") }
    if tok_put(t, agent, role) == 0 {
        errcode = 110
        errmsg = "could not store the token"
        return
    }
    token = t
    created = 1
}

func tok_for_agent(agent) (token, found) {
    token = ""
    found = 0
    docs := items_docs(st_find("tokens", "agent=" + agent, 1))
    if len(docs) == 0 { return }
    tv, terr := json_get(docs[0], ".token")
    if len(terr) > 0 { return }
    token = unq(tv)
    found = 1
}
