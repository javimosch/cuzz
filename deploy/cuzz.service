# /etc/systemd/system/cuzz.service
[Unit]
Description=cuzz — fleet communication relay
After=network.target

[Service]
Type=simple
ExecStart=/root/bin/cuzz serve --port 7700
Environment=CUZZ_DB=/root/.cuzz/cuzz.data
Environment=CUZZ_HUMAN=javi
# CUZZ_PASSWORD is the operator's login for the chat page. Keep it out of this
# unit (it is world-readable) — put it in the mode-0600 EnvironmentFile below.
EnvironmentFile=/etc/cuzz.env
Restart=always
RestartSec=5

# Safety net: cuzz had a memory leak (4.7GB RSS after 2 days) caused by
# unbounded SSE queries. The query is now capped at 50/tick, but the machin
# runtime's GC is not aggressive, so a hard ceiling prevents OOM-killing the
# host. 512MB is generous for a relay with <10k messages.
MemoryMax=512M
MemoryHigh=384M

# The relay only ever needs its own data directory.
NoNewPrivileges=true
# PrivateTmp / ProtectSystem / ReadWritePaths are deliberately absent: they need
# mount namespacing, which an unprivileged LXC container denies outright — the
# unit then fails with 226/NAMESPACE and restart-loops. Add them back on a real
# VM or a privileged container.

[Install]
WantedBy=multi-user.target
